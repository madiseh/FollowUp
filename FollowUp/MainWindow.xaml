<Window x:Class="FollowUp.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="فالوآپ ۱.۰.۰ | پیگیری پرونده‌های مالیاتی" Style="{StaticResource {x:Type Window}}" Icon="Assets/FollowUp.ico" Width="1150" Height="780" MinWidth="900" MinHeight="620" WindowState="Maximized" ResizeMode="CanResize" FlowDirection="LeftToRight" WindowStartupLocation="CenterScreen">
 <Grid Margin="26" FlowDirection="RightToLeft">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><StackPanel Orientation="Horizontal"><Image Source="Assets/FollowUp.png" Width="48" Height="48" Margin="0,0,0,12"/><TextBlock Text="فالوآپ" FontSize="30" FontWeight="Bold" VerticalAlignment="Center"/><TextBlock Text="نسخهٔ ۱.۰.۰" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel><TextBlock Text="پرونده‌ها، اقدام‌ها و مهلت‌ها؛ همه در یک نگاه" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" HorizontalAlignment="Left"><TextBlock x:Name="TodayLabel" FontSize="17" FontWeight="SemiBold"/><CheckBox x:Name="StartupToggle" Content="اجرا با ورود به ویندوز" Margin="0,12,0,0" Click="Startup_Click"/><Button Content="پشتیبان‌گیری" Style="{StaticResource Secondary}" Margin="0,12,0,0" Click="Backup_Click"/></StackPanel>
  </Grid>
  <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,18">
   <Border Background="White" CornerRadius="9" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="پرونده‌های فعال" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ActiveCount" FontSize="30" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border>
   <Border Background="#E8F4F1" CornerRadius="9" Padding="20" Margin="0,0,0,12"><StackPanel><TextBlock Text="اقدام‌های امروز" Foreground="#115E59"/><TextBlock x:Name="TodayCount" FontSize="30" FontWeight="Bold" Foreground="#115E59" Margin="0,8,0,0"/></StackPanel></Border>
   <Border Background="#FFF1E8" CornerRadius="9" Padding="20"><StackPanel><TextBlock Text="اقدام‌های عقب‌افتاده" Foreground="#9A3412"/><TextBlock x:Name="LateCount" FontSize="30" FontWeight="Bold" Foreground="#9A3412" Margin="0,8,0,0"/></StackPanel></Border>
  </UniformGrid>
  <Grid Grid.Row="2" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="Search" Margin="0,0,12,0" ToolTip="جست‌وجوی شرکت، پرونده، موضوع، مسئول یا اقدام" AutomationProperties.Name="جست‌وجو" TextChanged="Search_Changed"/><Button Grid.Column="1" Content="پاک‌کردن جست‌وجو" Style="{StaticResource Secondary}" Click="ClearSearch_Click"/></Grid>
  <TabControl x:Name="Pages" Grid.Row="3" SelectedIndex="0">
   <TabItem Header="کارتابل اقدام‌ها"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,14"><Button Content="+ اقدام و یادآوری" Click="AddTask_Click"/><Button Content="ویرایش" Style="{StaticResource Secondary}" Click="EditTask_Click"/><Button Content="انجام شد" Style="{StaticResource Secondary}" Click="CompleteTask_Click"/><Button Content="۱۵ دقیقه بعد" Style="{StaticResource Secondary}" Click="SnoozeTask_Click"/><CheckBox x:Name="ShowDone" Content="نمایش انجام‌شده‌ها و پرونده‌های بسته" VerticalAlignment="Center" Margin="14,0,0,0" Click="Filter_Click"/></WrapPanel>
    <DataGrid x:Name="TasksGrid" Grid.Row="1" MouseDoubleClick="EditTask_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="اقدام" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="شرکت" Binding="{Binding CompanyName}" Width="170"/><DataGridTextColumn Header="پرونده" Binding="{Binding CaseTitle}" Width="150"/><DataGridTextColumn Header="موعد شمسی" Binding="{Binding DueText}" Width="175"/><DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="110"/></DataGrid.Columns></DataGrid>
    <TextBlock Grid.Row="2" Text="برای هر اقدام، موعد و زمان یادآوری مستقل تعیین کنید. تاریخ‌ها: سال/ماه/روز، مانند ۱۴۰۵/۰۸/۱۵" Foreground="{StaticResource Muted}" Margin="0,12,0,0" TextWrapping="Wrap"/>
   </Grid></TabItem>
   <TabItem Header="پرونده‌ها"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,14"><Button Content="+ پرونده جدید" Click="AddCase_Click"/><Button Content="ویرایش پرونده" Style="{StaticResource Secondary}" Click="EditCase_Click"/><Button Content="ثبت مرحله / نتیجه" Style="{StaticResource Secondary}" Click="Stage_Click"/><Button Content="+ اقدام برای پرونده" Style="{StaticResource Secondary}" Click="CaseTask_Click"/><Button Content="مدارک" Style="{StaticResource Secondary}" Click="Documents_Click"/></WrapPanel>
    <DataGrid x:Name="CasesGrid" Grid.Row="1" SelectionChanged="Case_SelectionChanged" MouseDoubleClick="EditCase_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="شرکت" Binding="{Binding CompanyName}" Width="*"/><DataGridTextColumn Header="پرونده" Binding="{Binding Title}" Width="*"/><DataGridTextColumn Header="موضوع" Binding="{Binding Subject}" Width="110"/><DataGridTextColumn Header="دوره" Binding="{Binding Period}" Width="80"/><DataGridTextColumn Header="مرحله فعلی" Binding="{Binding Stage}" Width="170"/><DataGridTextColumn Header="مسئول" Binding="{Binding Owner}" Width="110"/></DataGrid.Columns></DataGrid>
    <TextBlock Grid.Row="2" Text="سابقهٔ مراحل پروندهٔ انتخاب‌شده" FontWeight="SemiBold" Margin="0,14,0,8"/>
    <DataGrid x:Name="HistoryGrid" Grid.Row="3"><DataGrid.Columns><DataGridTextColumn Header="تاریخ شمسی" Binding="{Binding DateText}" Width="130"/><DataGridTextColumn Header="مرحله" Binding="{Binding Stage}" Width="190"/><DataGridTextColumn Header="نتیجه / توضیحات" Binding="{Binding Notes}" Width="*"/></DataGrid.Columns></DataGrid>
   </Grid></TabItem>
   <TabItem Header="شرکت‌ها"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel Margin="0,0,0,14"><Button Content="+ شرکت جدید" Click="AddCompany_Click"/><Button Content="ویرایش شرکت" Style="{StaticResource Secondary}" Click="EditCompany_Click"/></WrapPanel><DataGrid x:Name="CompaniesGrid" Grid.Row="1" MouseDoubleClick="EditCompany_DoubleClick"><DataGrid.Columns><DataGridTextColumn Header="نام شرکت" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="شناسه ملی" Binding="{Binding NationalId}" Width="180"/><DataGridTextColumn Header="اطلاعات تماس" Binding="{Binding Contact}" Width="240"/><DataGridTextColumn Header="یادداشت" Binding="{Binding Notes}" Width="*"/></DataGrid.Columns></DataGrid></Grid></TabItem>
  </TabControl>
  <DockPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock x:Name="Footer" Text="برای شروع، یک شرکت و سپس پروندهٔ آن را ثبت کنید." Foreground="{StaticResource Muted}"/><TextBlock DockPanel.Dock="Left" Text="با بستن پنجره، یادآوری‌ها فعال می‌مانند." Foreground="{StaticResource Muted}" HorizontalAlignment="Left"/></DockPanel>
 </Grid>
</Window>
