<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable>
    <AssemblyName>FollowUp</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version><AssemblyVersion>1.0.0.0</AssemblyVersion><FileVersion>1.0.0.0</FileVersion>
    <Product>فالوآپ</Product><Description>پیگیری پرونده‌های مالیاتی و یادآوری اقدام‌ها</Description>
    <ApplicationIcon>Assets/FollowUp.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../FollowUp.Core/FollowUp.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/Fonts/*.ttf" /><Content Include="Assets/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/FollowUp.ico" /><Resource Include="Assets/FollowUp.png" /></ItemGroup>
</Project>
